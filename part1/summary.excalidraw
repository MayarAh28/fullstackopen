    {
      "id": "z2DnlqEI4FmWIYAh0ZbXN",
      "type": "text",
      "x": 707.0384179862674,
      "y": -1766.6560585567695,
      "width": 640.7109600815013,
      "height": 80.08887001018766,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 1913461610,
      "version": 95,
      "versionNonce": 1412304271,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793701689787,
      "created": 1793186050386,
      "link": null,
      "locked": false,
      "text": "a variable declared with const cannot be reassigned to a different value, the contents of\nthe object it references can still be modified. This is because the const declaration\nensures the immutability of the reference itself, not the data it points to. Think of it like\nchanging the furniture inside a house, while the address of the house remains the same.",
      "fontSize": 16.017774002037534,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a variable declared with const cannot be reassigned to a different value, the contents of the object it references can still be modified. This is because the const declaration ensures the immutability of the reference itself, not the data it points to. Think of it like changing the furniture inside a house, while the address of the house remains the same.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

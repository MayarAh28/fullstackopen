      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "c_EtUmvgs9SohkK0na5ZF",
      "type": "text",
      "x": 707.0384179862672,
      "y": -2571.535821388561,
      "width": 618.5874823150452,
      "height": 57.99257646703547,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 159187603,
      "version": 96,
      "versionNonce": 1516190529,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793701689787,
      "created": 1793101540978,
      "link": null,
      "locked": false,
      "text": "The official name of the JavaScript standard is ECMAScript. At this moment, the latest\nversion is the one released in June of 2025 with the name ECMAScript®2025, otherwise\nknown as ES16.",
      "fontSize": 15.464687057876128,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The official name of the JavaScript standard is ECMAScript. At this moment, the latest version is the one released in June of 2025 with the name ECMAScript®2025, otherwise known as ES16.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Z1U6hcMysQpjgDUipd4Ye",
      "type": "text",
      "x": 708.1445918745904,
      "y": -2500.049333855694,
      "width": 629.6492211982743,
      "height": 39.35307632489214,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 2058631670,
      "version": 46,
      "versionNonce": 1790301519,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793701689787,
      "created": 1793185088983,
      "link": null,
      "locked": false,
      "text": "Today, the most popular way to do transpiling is by using Babel. Transpilation is\nautomatically configured in React applications created with Vite.",
      "fontSize": 15.741230529956864,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Today, the most popular way to do transpiling is by using Babel. Transpilation is automatically configured in React applications created with Vite.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jzlmeM3QHbYP1PyjeRMvs",
      "type": "text",
      "x": 707.0384179862672,
      "y": -2444.3258242314278,
      "width": 616.3751345383982,
      "height": 38.52344590864989,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 1476740970,
      "version": 64,
      "versionNonce": 607660833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793701689787,
      "created": 1793185144338,
      "link": null,
      "locked": false,
      "text": "The latest versions of Node already understand the latest versions of JavaScript, so the\ncode does not need to be transpiled.",
      "fontSize": 15.409378363459957,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The latest versions of Node already understand the latest versions of JavaScript, so the code does not need to be transpiled.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "QJvq5Vv4___a9y9Qqcc98",
      "type": "text",
      "x": 705.9322440979444,
      "y": -2389.777624363505,
      "width": 625.2245256449825,
      "height": 97.69133213202848,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 1504684662,
      "version": 81,
      "versionNonce": 2064405359,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793701689787,
      "created": 1793185246875,
      "link": null,
      "locked": false,
      "text": "The code is written into files ending with .js that are run by issuing the command node\nname_of_file.js\n\nIt is also possible to write JavaScript code into the Node.js console, which is opened by\ntyping node in the command line, as well as into the browser's developer tool console.",
      "fontSize": 15.63061314112456,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The code is written into files ending with .js that are run by issuing the command node name_of_file.js\n\nIt is also possible to write JavaScript code into the Node.js console, which is opened by typing node in the command line, as well as into the browser's developer tool console.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "8-1kQPl5MYxuOxI1eILu-",
      "type": "image",
      "x": 703.3221486441021,
      "y": -2279.0355559068275,
      "width": 602.8509172268224,
      "height": 499.99059752194916,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,

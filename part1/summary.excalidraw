      "text": "Under the hood, JSX returned by React components is\ncompiled into JavaScript.",
      "fontSize": 14.376281429104083,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Under the hood, JSX returned by React components is compiled into JavaScript.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bmd4mjHAstuf2zYZev5wb",
      "type": "text",
      "x": 67.90848251310297,
      "y": -2470.7507865191646,
      "width": 383.2122065967127,
      "height": 34.41850906850212,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 329336560,
      "version": 319,

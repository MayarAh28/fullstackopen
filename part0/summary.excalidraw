      "seed": 179528823,
      "version": 49,
      "versionNonce": 2037156023,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792676638964,
      "created": 1792676635298,
      "link": null,
      "locked": false,
      "text": "Event handler functions are called callback functions. The application\ncode does not invoke the functions itself, but the runtime environment -\nthe browser - invokes the function at an appropriate time when the event\nhas occurred.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event handler functions are called callback functions. The application code does not invoke the functions itself, but the runtime environment - the browser - invokes the function at an appropriate time when the event has occurred.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ep5NM6AoUeDnbCBfo-ofx",
      "type": "text",
      "x": 1570.3265742014185,
      "y": -1393.3344191322626,
      "width": 800,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 1852498137,
      "version": 28,
      "versionNonce": 647667257,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792676767677,
      "created": 1792676763102,
      "link": null,
      "locked": false,
      "text": "Document Object Model, or DOM, is an Application Programming Interface\n(API) that enables programmatic modification of the element trees\ncorresponding to web pages.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Document Object Model, or DOM, is an Application Programming Interface (API) that enables programmatic modification of the element trees corresponding to web pages.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SayvNPP1AtJqdhMIUr06n",
      "type": "text",
      "x": 1569.1178768991101,
      "y": -1300.2647268545088,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 634738999,
      "version": 36,
      "versionNonce": 1659200025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792676851164,
      "created": 1792676843878,
      "link": null,
      "locked": false,
      "text": "The topmost node of the DOM tree of an HTML document is called the\ndocument",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The topmost node of the DOM tree of an HTML document is called the document",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ld3F2m0wyGaGtOTOoBfO0",
      "type": "image",
      "x": 1570.405381265529,
      "y": -1239.9018722982632,
      "width": 489.3647933067175,
      "height": 346.837297256136,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,

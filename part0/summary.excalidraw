    {
      "id": "8Jr0wcdOEJkoLCOR9cCqi",
      "type": "text",
      "x": 1575.1613634106523,
      "y": -1509.369360153878,
      "width": 800,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
